# Environment Variables Template
# Copy this file to .env.local and fill in your values

# GitHub API (for fetching projects dynamically - optional)
VITE_GITHUB_USERNAME=your-github-username
VITE_GITHUB_TOKEN=your-personal-access-token

# Email Service (for contact form - optional)
VITE_EMAIL_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# Analytics (optional)
VITE_ANALYTICS_ID=your-google-analytics-id
